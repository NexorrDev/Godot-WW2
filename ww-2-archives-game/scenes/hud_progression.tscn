[node name="HUDProgression" type="CanvasLayer"]
layer = 8
script = ExtResource("1_hud")

[node name="RootControl" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BadgePanel" type="PanelContainer" parent="RootControl"]
unique_name_in_owner = true
layout_mode = 1
offset_left = 20.0
offset_top = 20.0
offset_right = 320.0
offset_bottom = 128.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_badge")

[node name="BadgeVBox" type="VBoxContainer" parent="RootControl/BadgePanel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="HeaderLabel" type="Label" parent="RootControl/BadgePanel/BadgeVBox"]
layout_mode = 2
text = "ÉTAT-MAJOR // REGISTRE DE GUERRE"
label_settings = SubResource("LabelSettings_badge_header")

[node name="CounterLabel" type="Label" parent="RootControl/BadgePanel/BadgeVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "ARCHIVES IDENTIFIÉES : 0 / 15"
label_settings = SubResource("LabelSettings_badge_counter")

[node name="ProgressBar" type="ProgressBar" parent="RootControl/BadgePanel/BadgeVBox"]
